# {{ ansible_managed }}
name: edge

x-hardening: &hardening
  restart: unless-stopped
  security_opt: ["no-new-privileges:true"]
  cap_drop: [ALL]
  logging:
    driver: local
    options: {max-size: 10m, max-file: "3"}

services:
  headscale:
    <<: *hardening
    image: {{ headscale_image }}
    command: serve
    read_only: true
    ports:
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:9090:9090"
      - "3478:3478/udp"
    volumes:
      - ./headscale:/etc/headscale:ro
      - headscale-data:/var/lib/headscale
      - headscale-run:/var/run/headscale
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  caddy:
    <<: *hardening
    image: edge-caddy:{{ caddy_version }}-{{ caddy_ratelimit_commit[:12] }}
    build:
      context: ./caddy
      args:
        CADDY_BUILDER_IMAGE: {{ caddy_builder_image }}
        CADDY_RUNTIME_IMAGE: {{ caddy_runtime_image }}
        CADDY_VERSION: "{{ caddy_version }}"
        CADDY_DNS_DESEC_VERSION: {{ caddy_dns_desec_version }}
        CADDY_RATELIMIT_COMMIT: {{ caddy_ratelimit_commit }}
    # Host networking: real client IPs for rate limits and tailnet matching, and a route to 100.64.0.0/10.
    network_mode: host
    cap_add: [NET_BIND_SERVICE]
    env_file: [./caddy/caddy.env]
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
      - /var/log/caddy:/var/log/caddy
    depends_on:
      headscale: {condition: service_healthy}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3

  kuma:
    <<: *hardening
    image: {{ uptime_kuma_image }}
    # The image's /app/data belongs to uid 1000; run as that user instead of granting root DAC_OVERRIDE.
    user: "1000:1000"
    ports: ["127.0.0.1:3001:3001"]
    # MagicDNS: tailnet names (app.{{ magicdns_base_domain }}) and the split-horizon record resolve here.
    dns: [100.100.100.100]
    volumes:
      - kuma-data:/app/data
    mem_limit: 384m

  ntfy:
    <<: *hardening
    image: {{ ntfy_image }}
    command: serve
    ports: ["127.0.0.1:2586:2586"]
    volumes:
      - ./ntfy/server.yml:/etc/ntfy/server.yml:ro
      - ntfy-data:/var/lib/ntfy
    mem_limit: 128m
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2586/v1/health"]
      interval: 30s
      timeout: 5s
      retries: 3

volumes:
  headscale-data:
  headscale-run:
  caddy-data:
  caddy-config:
  kuma-data:
  ntfy-data:
