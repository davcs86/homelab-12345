# {{ ansible_managed }}
server_url: https://{{ headscale_hostname }}
# Behind Caddy on the same host; published only on 127.0.0.1.
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false
trusted_proxies: [127.0.0.1/32, 172.16.0.0/12]

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: {{ tailnet_v4_prefix }}
  v6: {{ tailnet_v6_prefix }}
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: edge
    region_name: Edge SFO3 (embedded)
    verify_clients: true
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
    # No fixed ipv4: clients resolve the hostname; the edge itself resolves it to 127.0.0.1 (/etc/hosts),
    # so it never depends on hairpinning through its own reserved IP.
  # Embedded relay only: no dependency on Tailscale Inc.'s DERP fleet.
  urls: []
  paths: []
  auto_update_enabled: false

disable_check_updates: true

node:
  expiry: 0
  ephemeral:
    inactivity_timeout: {{ ephemeral_inactivity_timeout }}

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

# TLS is terminated by Caddy.
tls_cert_path: ""
tls_key_path: ""

log:
  level: info
  format: json

policy:
  mode: file
  path: /etc/headscale/policy.hujson

dns:
  magic_dns: true
  base_domain: {{ magicdns_base_domain }}
  override_local_dns: false
  nameservers:
    global: []
    split: {}
  search_domains: []
  extra_records_path: /etc/headscale/extra-records.json

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

logtail:
  enabled: false

taildrop:
  enabled: false
