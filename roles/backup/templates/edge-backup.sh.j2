#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly: consistent headscale snapshot -> tar -> age -> local + rsync to the home backup host.
set -euo pipefail
umask 077

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
vol_root=/var/lib/docker/volumes
out_dir=/var/backups/edge
archive="$out_dir/edge-$stamp.tar.age"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

mkdir -p "$out_dir" "$work/headscale"

# SQLite online backup API: consistent under concurrent writes, WAL included.
sqlite3 "$vol_root/edge_headscale-data/_data/db.sqlite" ".backup '$work/headscale/db.sqlite'"
sqlite3 "$work/headscale/db.sqlite" 'PRAGMA integrity_check;' | grep -qx ok
cp "$vol_root/edge_headscale-data/_data/noise_private.key" "$work/headscale/"
cp "$vol_root/edge_headscale-data/_data/derp_server_private.key" "$work/headscale/"
cp {{ edge_root }}/headscale/config.yaml {{ edge_root }}/headscale/policy.hujson {{ edge_root }}/headscale/extra-records.json "$work/headscale/"

( cd "$work" && find headscale -type f -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256 )
tar -C "$work" -cf - . | age -R /etc/edge-backup/recipients.txt -o "$archive.partial"
mv "$archive.partial" "$archive"
sha256sum "$archive" | sed "s#$out_dir/##" > "$archive.sha256"

rsync -a --chmod=F600 -e "ssh -i /etc/edge-backup/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes \
  -o UserKnownHostsFile=/etc/edge-backup/known_hosts -o StrictHostKeyChecking={{ 'yes' if backup_host_known_hosts | default('') else 'accept-new' }}" \
  "$archive" "$archive.sha256" "{{ backup_remote_user }}@{{ backup_tailnet_host }}:{{ backup_remote_path }}/"

find "$out_dir" -name 'edge-*.tar.age*' -mtime +{{ backup_local_retention_days }} -delete
echo "backup ok: $archive"
